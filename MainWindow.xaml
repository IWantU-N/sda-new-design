<Window x:Class="SdaDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SDA Desk" Height="780" Width="1200" MinHeight="560" MinWidth="820" Icon="{DynamicResource AppIconImage}"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" Foreground="#EDF3FA"
        FontFamily="Segoe UI Variable, Segoe UI" Loaded="Window_Loaded" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="10" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DrawingImage x:Key="AppIconImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1E3A31" Geometry="M32,3 C48,3 61,16 61,32 C61,48 48,61 32,61 C16,61 3,48 3,32 C3,16 16,3 32,3 Z"/>
                    <GeometryDrawing Brush="#132921" Geometry="M32,9 L49,16 L49,29 C49,41 41,49 32,55 C23,49 15,41 15,29 L15,16 Z">
                        <GeometryDrawing.Pen><Pen Brush="#84F0B5" Thickness="2.5"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#84F0B5" Geometry="M40,22 C37,17 27,17 24,22 C20,29 42,28 40,36 C39,43 27,45 23,39 L27,36 C30,40 36,39 36,36 C36,33 23,33 23,26 C23,17 36,15 42,19 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <ControlTemplate x:Key="AppLogoTemplate" TargetType="ContentControl">
            <Border Background="{StaticResource AccentDimBrush}" CornerRadius="12">
                <Viewbox Stretch="Uniform" Margin="6">
                    <Canvas Width="40" Height="40">
                        <Path Data="M20,2 L36,8.5 L36,19 C36,29 29,35 20,39 C11,35 4,29 4,19 L4,8.5 Z" Fill="#132921" Stroke="#84F0B5" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                        <Path Data="M27,13 C24,9 14,10 13,16 C12,22 27,19 27,25 C27,31 16,32 12,27" Stroke="#84F0B5" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Ellipse Canvas.Left="27" Canvas.Top="8" Width="3" Height="3" Fill="#D4FFE7"/>
                    </Canvas>
                </Viewbox>
            </Border>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#111820" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
                    <ContentControl Width="25" Height="25" Template="{StaticResource AppLogoTemplate}" Margin="0,0,9,0"/>
                    <TextBlock Text="SDA Desk" FontSize="12" FontWeight="SemiBold" Foreground="#DCE5EF" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Width="46" Height="42" Click="MinimizeWindow_Click" Style="{StaticResource CaptionButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть"/>
                    <Button x:Name="MaximizeWindowButton" Content="□" Width="46" Height="42" Click="MaximizeWindow_Click" Style="{StaticResource CaptionButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Развернуть"/>
                    <Button Content="×" Width="48" Height="42" Click="CloseWindow_Click" Style="{StaticResource CloseCaptionButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="276"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,22,18,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,28">
                    <ContentControl Width="42" Height="42" Template="{StaticResource AppLogoTemplate}" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="SDA DESK" FontSize="14" FontWeight="Bold"/><TextBlock Text="STEAM AUTHENTICATOR" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,24">
                    <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,9"/>
                    <Border Background="{StaticResource AccentDimBrush}" CornerRadius="10" Padding="12,10"><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,11,0"/><TextBlock Text="Authenticator" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="ЛОКАЛЬНО" Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" Margin="22,3,0,0"/></StackPanel></Border>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="АККАУНТЫ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="8,3"><TextBlock x:Name="AccountCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/></Border>
                </Grid>
                <Grid Grid.Row="3" Margin="0,0,0,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по имени аккаунта" Padding="33,9,34,9"/>
                        <TextBlock Text="⌕" FontSize="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="11,0,0,1" IsHitTestVisible="False"/>
                        <Button x:Name="SearchClearButton" Content="×" Click="SearchClear_Click" Padding="5,0" FontSize="15" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="Очистить поиск" Visibility="Collapsed"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="AccountList" SelectionChanged="AccountList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="#EAF0F7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="9,8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#1A2830"/><Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="itemBorder" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#17212B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="9" Background="#202B37" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Steam Guard" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Code}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="NoSearchResults" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="185"><TextBlock Text="Ничего не найдено" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Измени запрос или очисти поиск." FontSize="10" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                    </Grid>
                </Grid>
                <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="12">
                    <StackPanel><StackPanel Orientation="Horizontal"><Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Локальное хранение" FontWeight="SemiBold" FontSize="11"/></StackPanel><TextBlock x:Name="DataPathText" Text="maFiles рядом с приложением" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><TextBlock Text="Файлы и токены хранятся без шифрования." TextWrapping="Wrap" FontSize="10" Foreground="#D0AC82" Margin="0,6,0,0"/><TextBlock x:Name="PendingStatusText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="10" Foreground="#F0B979" Margin="0,8,0,0"/></StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="34,28,34,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,19">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="STEAM GUARD" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Ваши коды" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="Актуальные коды и подтверждения аккаунтов в одном месте." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="12,9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="ЛОКАЛЬНЫЙ РЕЖИМ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border></Grid>
                <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,16,0,0">
                    <Button Content="⇄  Подтверждения" Click="Confirmations_Click" Margin="0,0,8,0" Padding="10,9" ToolTip="Проверить и обработать подтверждения Steam"/>
                    <Button Content="＋  Подключить Steam" Click="LinkSteam_Click" Background="{StaticResource AccentBrush}" Foreground="#0C1711" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,8,0" Padding="10,9" ToolTip="Добавить новый аутентификатор в Steam"/>
                    <Button Content="Собрать maFile" Click="Create_Click" Margin="0,0,8,0" Padding="10,9" ToolTip="Создать файл из уже существующих данных аутентификатора"/>
                    <Button Content="↓  Импорт" Click="Import_Click" Padding="10,9" ToolTip="Импортировать существующий maFile"/>
                </UniformGrid>
            </Grid>
            <Grid Grid.Row="1">
                <Border x:Name="EmptyState" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="20" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <Border Width="68" Height="68" CornerRadius="22" Background="{StaticResource AccentDimBrush}" Margin="0,0,0,19"><TextBlock Text="◈" FontSize="29" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Добавьте первый аккаунт" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Подключите новый Steam Guard или импортируйте уже существующий maFile. Ручное создание подходит только для имеющихся секретов." Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Подключить Steam" Click="LinkSteam_Click" Background="{StaticResource AccentBrush}" Foreground="#0C1711" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,9,0"/><Button Content="Импортировать maFile" Click="Import_Click"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="CodeCard" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="20" Visibility="Collapsed">
                    <Grid Margin="26">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="Экспорт" Click="Export_Click" Margin="12,0,0,0" Padding="11,8" ToolTip="Сохранить открытую копию maFile"/><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="14" Background="#202B37" Margin="0,0,12,0"><TextBlock x:Name="SelectedInitial" Text="S" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SelectedName" Text="Steam account" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="SelectedDescription" Text="Steam Guard · одноразовый код" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel></DockPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,12"><Border Background="#0E151C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="36,21"><StackPanel><TextBlock Text="ВАШ КОД STEAM GUARD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="CodeText" Text="·····" FontFamily="Cascadia Mono, Consolas" FontSize="64" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,5,0,4"/></StackPanel></Border><Button Content="⧉  Копировать код" Click="Copy_Click" HorizontalAlignment="Center" Padding="20,10" Margin="0,15,0,0"/><TextBlock x:Name="AccountStatus" Text="Код обновляется автоматически" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
                        <StackPanel Grid.Row="2"><Grid Margin="0,0,0,8"><TextBlock Text="До обновления кода" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="CountdownText" Text="30 сек" Foreground="{StaticResource AccentBrush}" FontSize="10" HorizontalAlignment="Right"/></Grid><ProgressBar x:Name="CountdownBar" Height="5" Minimum="0" Maximum="30" Value="30" Foreground="{StaticResource AccentBrush}" Background="#27313B" BorderThickness="0"/></StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Готово" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="Удалить локальную копию" Click="Delete_Click" HorizontalAlignment="Right" Padding="10,7" FontSize="10" ToolTip="Удалить выбранный maFile с этого устройства"/></Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
