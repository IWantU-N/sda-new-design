<Window x:Class="SdaDesk.ConfirmationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Подтверждения Steam" Width="1000" Height="820" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}" Foreground="#EDF3FA" FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="STEAM GUARD" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10"/><TextBlock Text="Подтверждения обменов, продаж и покупок" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="Выбери аккаунты, проверь список и подтверди выбранные пункты одним действием." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" x:Name="RefreshButton" Content="Обновить" ToolTip="Обновить по выбранным аккаунтам" Click="Refresh_Click" VerticalAlignment="Center"/></Grid>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,0,12"><StackPanel><CheckBox x:Name="AllAccountsCheckBox" Content="Все аккаунты" FontSize="13" FontWeight="SemiBold" IsChecked="True" IsThreeState="True" Click="AllAccounts_Click"/><ItemsControl x:Name="AccountChoicesList" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="AccountChoice_Changed" Unchecked="AccountChoice_Changed" Margin="0,0,18,4" FontSize="12" Foreground="#CBD4E0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Grid Grid.Row="2" Margin="0,0,0,10"><CheckBox x:Name="AllConfirmationsCheckBox" Content="Выбрать все подтверждения" IsThreeState="True" IsEnabled="False" Click="AllConfirmations_Click" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="SelectedCountText" Text="Выбрано: 0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button x:Name="DenySelectedButton" Content="Отклонить выбранные" Click="DenySelected_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ConfirmSelectedButton" Content="Подтвердить выбранные" Click="ConfirmSelected_Click" IsEnabled="False" Background="{StaticResource AccentBrush}" Foreground="#0C1711" BorderBrush="{StaticResource AccentBrush}"/></StackPanel></Grid>
        <Grid Grid.Row="3"><Border x:Name="EmptyState" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontSize="42" HorizontalAlignment="Center"/><TextBlock Text="Нет ожидающих подтверждений" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="Обнови список выбранных аккаунтов." Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Border>
            <ListBox x:Name="ConfirmationList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsActionable}" Checked="ConfirmationChoice_Changed" Unchecked="ConfirmationChoice_Changed" VerticalAlignment="Top" Margin="0,2,14,0"/><StackPanel Grid.Column="1"><DockPanel><TextBlock Text="{Binding TypeName}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding AccountName}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding Headline}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding ActionabilityText}" Foreground="#D0AC82" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Выбери аккаунты и обнови список." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="Проверь название предмета и сумму перед подтверждением покупки." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="260" VerticalAlignment="Center" TextAlignment="Right"/></Grid>
    </Grid>
</Window>
