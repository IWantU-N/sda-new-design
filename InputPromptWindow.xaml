<Window x:Class="SdaDesk.InputPromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Подтверждение Steam" Width="450" SizeToContent="Height" MinHeight="250" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource CanvasBrush}" Foreground="#EDF3FA" FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="Eyebrow" Text="STEAM" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10"/><TextBlock x:Name="PromptTitle" Text="Подтверждение" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="PromptDescription" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16"/></StackPanel>
        <TextBox x:Name="ValueBox" Grid.Row="1" Margin="0,0,0,18"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" Click="Cancel_Click" Margin="0,0,9,0"/><Button Content="Продолжить" Click="Accept_Click" Background="{StaticResource AccentBrush}" Foreground="#0C1711" BorderBrush="{StaticResource AccentBrush}"/></StackPanel>
    </Grid>
</Window>
