<Window x:Class="SdaDesk.ActivationPromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Активировать Steam Guard" Width="500" Height="600" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource CanvasBrush}" Foreground="#EDF3FA" FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="ПОСЛЕДНИЙ ШАГ" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10"/><TextBlock Text="Сохрани код восстановления" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Запиши этот revocation code в безопасное место. Он понадобится для восстановления или снятия аутентификатора." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,18"/></StackPanel>
        <StackPanel Grid.Row="1">
            <Border Background="#171D25" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18"><StackPanel><TextBlock Text="REVOCATION CODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="RevocationCodeText" Text="R00000" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
            <TextBlock Text="Код из SMS" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SmsCodeBox" Margin="0,0,0,16"/>
            <TextBlock Text="Введи revocation code ещё раз для подтверждения" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBox x:Name="RevocationCodeBox" Margin="0,0,0,14"/>
            <Border Background="#241C16" BorderBrush="#4D3925" BorderThickness="1" CornerRadius="10" Padding="12"><TextBlock Text="Аккаунт появится в списке только после успешной активации Steam и совпадения кода восстановления. Файл будет сохранён без шифрования." FontSize="11" Foreground="#E7C69D" TextWrapping="Wrap"/></Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Отмена" Click="Cancel_Click" Margin="0,0,9,0"/><Button Content="Активировать" Click="Accept_Click" Background="{StaticResource AccentBrush}" Foreground="#0C1711" BorderBrush="{StaticResource AccentBrush}"/></StackPanel>
    </Grid>
</Window>
