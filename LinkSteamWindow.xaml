<Window x:Class="SdaDesk.LinkSteamWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Подключить Steam" Width="520" Height="650" MinHeight="580" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource CanvasBrush}" Foreground="#EDF3FA" FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="ПРИВЯЗКА АУТЕНТИФИКАТОРА" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10"/><TextBlock Text="Подключить аккаунт Steam" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="Войди в Steam. SDA Desk отправит данные только серверам Steam для входа и привязки." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,20"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Логин Steam" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="UsernameBox" Margin="0,0,0,15"/>
            <TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/><PasswordBox x:Name="PasswordBox" Background="#0D1219" Foreground="#EDF3FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10" FontSize="14" Margin="0,0,0,18"/>
            <Border Background="#171D25" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="Как пройдёт привязка" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="1. Введи Steam Guard-код из письма (если Steam его запросит).&#x0a;2. Подтверди добавление номера телефона по ссылке из письма, если Steam попросит.&#x0a;3. Введи SMS-код и повторно введи показанный revocation code." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Background="#241C16" BorderBrush="#4D3925" BorderThickness="1" CornerRadius="10" Padding="13"><TextBlock Text="Пароль используется только во время входа и не сохраняется в SDA Desk. После привязки maFile, включая revocation code и секреты, сохраняется без шифрования." FontSize="11" Foreground="#E7C69D" TextWrapping="Wrap"/></Border>
            <TextBlock x:Name="ProgressText" Text="Готово к входу" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="1,14,0,0"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" Margin="0,0,10,0"/><Button x:Name="LinkButton" Content="Войти и привязать" Click="Link_Click" Background="{StaticResource AccentBrush}" Foreground="#0C1711" BorderBrush="{StaticResource AccentBrush}"/></StackPanel>
    </Grid>
</Window>
